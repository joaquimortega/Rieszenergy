private theorem abs_unequalAPowSSTT_le
    {α s t : ℝ} {m : ℕ}
    (hα0 : 0 < α) (hα2 : α < 2)
    (hs : s ∈ Icc (-1 : ℝ) 1) (ht : t ∈ Icc (-1 : ℝ) 1)
