    (∑ j ∈ Finset.Icc 1 (2 * bandParameter N - 1), population N j) = N := by
  let M := bandParameter N
  have hM : 1 ≤ M := bandParameter_pos hN
  have hfin := Fin.sum_univ_eq_sum_range
