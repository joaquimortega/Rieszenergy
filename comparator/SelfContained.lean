        _ ≤ _ := mul_le_mul_of_nonneg_right hcoef hA4nonneg

private theorem rpow_sub_nat_mul_pow
    {A e : ℝ} (hA : 0 < A) (k : ℕ) :
    A ^ (e - k) * A ^ k = A ^ e := by
  rw [← Real.rpow_natCast]
  rw [← Real.rpow_add hA]
  congr 1
  ring


theorem abs_separatedEvenPowerSummandDSSTT_le
