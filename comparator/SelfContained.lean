            gcongr
          _ = 200 * w ^ 2 * (16 * A ^ (e - 4)) := by ring
    _ ≤ 32768 * w ^ 4 * A ^ (e - 4) := by
      have hcoef : 29200 * w ^ 4 ≤ 32768 * w ^ 4 := by
